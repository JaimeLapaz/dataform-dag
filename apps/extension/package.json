{
  "name": "dataform-dag-explorer",
  "displayName": "Dataform DAG Explorer",
  "version": "0.1.0",
  "private": true,
  "description": "Explore Dataform dependency graphs with parsed and compiled modes, local compiled SQL preview, tag filtering, search and diagnostics.",
  "publisher": "jaimelapaz",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/JaimeLapaz/dataform-dag.git",
    "directory": "apps/extension"
  },
  "bugs": {
    "url": "https://github.com/JaimeLapaz/dataform-dag/issues"
  },
  "homepage": "https://github.com/JaimeLapaz/dataform-dag#readme",
  "keywords": [
    "dataform",
    "dag",
    "sqlx",
    "dependency graph",
    "lineage",
    "compiled sql",
    "bigquery",
    "data engineering"
  ],
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "pricing": "Free",
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Dataform DAG Explorer reads project files and can run local Dataform compilation, which may evaluate project JavaScript."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "dataformDagExplorer.showGraph",
        "title": "Show Graph",
        "category": "Dataform DAG Explorer"
      },
      {
        "command": "dataformDagExplorer.showCompiledSql",
        "title": "Show Compiled SQL",
        "category": "Dataform DAG Explorer"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "vscode:prepublish": "npm run build --prefix ../../packages/core && npm run build",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@dataform-dag/core": "*",
    "@dataform-dag/ui": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.21.5",
    "jsdom": "^25.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}